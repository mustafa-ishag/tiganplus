# إعدادات مجلد public
# Public folder settings

# تفعيل محرك إعادة الكتابة
RewriteEngine On

# إعادة توجيه HTTP إلى HTTPS (للاستضافة)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# إعدادات PHP
<IfModule mod_php.c>
    # إعدادات الجلسة
    php_value session.cookie_httponly 1
    php_value session.use_only_cookies 1
    php_value session.cookie_secure 0
    php_value session.gc_maxlifetime 7200
    php_value session.cookie_lifetime 0
    
    # إعدادات الأخطاء
    php_flag display_errors Off
    php_flag log_errors On
    php_value error_log "error.log"
    
    # إعدادات الذاكرة والوقت
    php_value max_execution_time 60
    php_value memory_limit 256M
    
    # إعدادات الترميز
    php_value default_charset "UTF-8"
    php_value mbstring.internal_encoding "UTF-8"
</IfModule>

# إعدادات الأمان
<Files "*.php">
    Order Allow,Deny
    Allow from all
</Files>

# منع الوصول لملفات التكوين الحساسة
<FilesMatch "\.(env|config|ini|log)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# إعدادات MIME
<IfModule mod_mime.c>
    AddDefaultCharset UTF-8
    AddType application/javascript .js
    AddType text/css .css
</IfModule>

# إعدادات الضغط
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# إعدادات التخزين المؤقت
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
</IfModule>

# منع عرض محتويات المجلدات
Options -Indexes

# إعدادات الترميز للملفات العربية
AddDefaultCharset UTF-8

# إعادة توجيه للملفات المفقودة
<IfModule mod_rewrite.c>
    # إعادة توجيه logout القديم
    RewriteRule ^auth/logout\.php$ logout.php [R=301,L]
    
    # إعادة توجيه المسارات القديمة
    RewriteRule ^/etganplus/public/auth/logout\.php$ logout.php [R=301,L]
    RewriteRule ^/tiqanplus/public/auth/logout\.php$ logout.php [R=301,L]
</IfModule>
