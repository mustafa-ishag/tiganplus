# إعدادات خاصة بمجلد المصادقة
# Authentication folder settings

# تفعيل محرك إعادة الكتابة
RewriteEngine On

# إعدادات PHP للاستضافة
<IfModule mod_php.c>
    # إعدادات الجلسة
    php_value session.cookie_httponly 1
    php_value session.use_only_cookies 1
    php_value session.cookie_secure 0
    php_value session.gc_maxlifetime 7200
    php_value session.cookie_lifetime 0
    
    # إعدادات الأخطاء للإنتاج
    php_flag display_errors Off
    php_flag log_errors On
    php_value error_log "error.log"
    
    # إعدادات الذاكرة والوقت
    php_value max_execution_time 30
    php_value memory_limit 128M
    
    # إعدادات الترميز
    php_value default_charset "UTF-8"
    php_value mbstring.internal_encoding "UTF-8"
</IfModule>

# إعدادات الأمان
<Files "*.php">
    Order Allow,Deny
    Allow from all
</Files>

# منع الوصول لملفات التكوين
<Files "config.php">
    Order Deny,Allow
    Deny from all
</Files>

# إعدادات MIME
<IfModule mod_mime.c>
    AddDefaultCharset UTF-8
</IfModule>

# إعدادات الضغط
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript
</IfModule>

# إعدادات التخزين المؤقت
<IfModule mod_expires.c>
    ExpiresActive Off
</IfModule>

# منع عرض محتويات المجلد
Options -Indexes

# إعدادات الترميز للملفات العربية
AddDefaultCharset UTF-8
